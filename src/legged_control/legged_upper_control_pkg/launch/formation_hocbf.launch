<?xml version="1.0"?>
<launch>
    <arg name="debug_frame_id" default="map"/>
    <arg name="debug_publish_enabled" default="true"/>

    <!-- Fleet manager (modularized version) -->
    <node pkg="legged_upper_control"
          type="fleet_manager_node.py"
          name="fleet_manager"
          output="screen">
        <rosparam file="$(find legged_upper_control)/config/Cbf_params_twoOrderCBF.yaml"
                  command="load"/>
        <param name="debug_frame_id" value="$(arg debug_frame_id)"/>
        <param name="debug_publish_enabled" value="$(arg debug_publish_enabled)"/>
    </node>
</launch>