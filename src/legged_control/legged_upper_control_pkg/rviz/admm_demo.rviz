Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Background Color: 30; 30; 30
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 100; 100; 100
    - Class: rviz/TF
      Name: TF
      Enabled: false
    - Class: rviz/MarkerArray
      Name: ADMM rollout
      Enabled: true
      Marker Topic: /formation/admm_markers
      Queue Size: 10
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Name: Orbit
      Distance: 16
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 3.14
Window Geometry:
  Height: 800
  Width: 1200
